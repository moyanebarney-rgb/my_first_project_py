# 14. QUERY 9: Department averages vs overall average (CTE)
# ============================================
query9 = """
WITH dept_avg AS (
    SELECT
        department,
        AVG(salary) as avg_salary
    FROM employees
    GROUP BY department
),
overall_avg AS (
    SELECT AVG(salary) as overall_avg FROM employees
)
SELECT
    dept_avg.department,
    dept_avg.avg_salary,
    overall_avg.overall_avg,
    ROUND((dept_avg.avg_salary - overall_avg.overall_avg), 2) as difference
FROM dept_avg, overall_avg
ORDER BY difference DESC
"""
