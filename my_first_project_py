# 18. QUERY 13: Conditional Aggregation (CASE WHEN)
# ============================================
query13 = """
SELECT 
    department,
    COUNT(*) as total_employees,
    SUM(CASE WHEN salary > 70000 THEN 1 ELSE 0 END) as high_earners,
    SUM(CASE WHEN salary <= 70000 THEN 1 ELSE 0 END) as low_earners,
    ROUND(100.0 * SUM(CASE WHEN salary > 70000 THEN 1 ELSE 0 END) / COUNT(*), 2) as high_earner_pct
FROM employees
GROUP BY department
"""
cursor.execute(query13)
conditional_agg = cursor.fetchall()

