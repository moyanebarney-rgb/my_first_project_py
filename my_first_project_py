# 19. QUERY 14: Salary Outlier Detection
# ============================================
query14 = """
SELECT 
    e1.name,
    e1.department,
    e1.salary,
    ROUND((SELECT AVG(salary) FROM employees e2 WHERE e2.department = e1.department), 2) as dept_avg,
    ROUND(e1.salary - (SELECT AVG(salary) FROM employees e2 WHERE e2.department = e1.department), 2) as difference,
    ROUND(100.0 * (e1.salary - (SELECT AVG(salary) FROM employees e2 WHERE e2.department = e1.department)) / 
          (SELECT AVG(salary) FROM employees e2 WHERE e2.department = e1.department), 2) as pct_above_avg
FROM employees e1
WHERE e1.salary > (SELECT AVG(salary) FROM employees e2 WHERE e2.department = e1.department) * 1.2
"""
cursor.execute(query14)
outliers = cursor.fetchall()

with open('salary_outliers.csv', 'w', newline='') as file:
    writer = csv.writer(file)
    writer.writerow(['Name', 'Department', 'Salary', 'Dept Average', 'Difference', '% Above Avg'])
